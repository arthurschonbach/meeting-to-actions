# Required for generating deliverables. Without it, only the sample meeting works.
# Set this to your OpenRouter API key.
OPENAI_API_KEY=

# Optional. Defaults to https://openrouter.ai/api/v1
# OPENAI_BASE_URL=

# Optional. Any OpenRouter model id. Defaults to nvidia/nemotron-3-super-120b-a12b:free.
OPENAI_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Optional. Defaults to ./data/meetings.db
# DATABASE_PATH=
